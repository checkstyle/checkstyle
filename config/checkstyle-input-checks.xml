<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="haltOnException" value="false"/>

  <property name="cacheFile" value="target/cache_input_resources"/>

  <!-- Suppressions for resources -->
  <module name="SuppressionFilter">
    <property name="file"
             value="config/checkstyle-input-suppressions.xml"/>
  </module>
  <!-- Miscellaneous -->
  <module name="NewlineAtEndOfFile" />

  <module name="RegexpSingleline">
    <property name="id" value="noCheckstyleInInputs"/>
    <property name="format" value="import com.puppycrawl.tools.checkstyle"/>
    <property name="fileExtensions" value="java"/>
    <property name="message" value="Inputs should not reference checkstyle's own files"/>
  </module>
  <module name="RegexpSingleline">
    <property name="id" value="presenceOfCompilationComment"/>
    <property name="format" value="^// non-compiled with javac: (Compilable with Java(\d+)|(contains specially crafted set of imports)|(but was compiled on jdk before)|(missing package)|(package statement is different than folder)|(reference to non existent))"/>
    <property name="message"
              value="Missing compilation comment"/>
    <property name="fileExtensions" value="java"/>
    <property name="minimum" value="1"/>
    <property name="maximum" value="2"/>
  </module>

  <!--
    '[^/]' after the opening '/**' used to swallow the third asterisk of an empty
    '/***/' Javadoc, so the trailing '/' no longer closed it. The pattern then ran on
    and paired the next Javadoc's '*/' with any '// ... violation ...' line in between,
    reporting comments that are not inside a Javadoc at all. A negative lookahead keeps
    '/**/' from opening a Javadoc without consuming anything, so '*/' still terminates.
    See https://github.com/checkstyle/checkstyle/issues/19764
  -->
  <module name="RegexpMultiline">
    <property name="id" value="noViolationCommentsInJavadoc"/>
    <property name="matchAcrossLines" value="true"/>
    <property name="format"
              value="\/\*\*(?!\/)(?:[^*]|\*(?!\/))*?(\/\/[^\n]+violation[^\n]+)\n(?:[^*]|\*(?!\/))*?\*\/"/>
    <property name="message" value="Violation comments should not be placed inside Javadoc."/>
  </module>

  <!--
    These two rules used to be MatchXpath queries anchored on MODIFIERS. That was wrong
    twice over, see https://github.com/checkstyle/checkstyle/issues/21552

    1) Missed violations. A comment is attached to the AST as the previous sibling of the
       node built from the next real token, so where it lands depends on what follows it:
       a modifier keyword puts it under MODIFIERS, but a bare return type puts it under
       TYPE, 'class'/'record'/a ctor IDENT puts it directly under the declaration, and
       'module' puts it under MODULE_DEF (whose annotation holder is ANNOTATIONS, not
       MODIFIERS). Anchoring on MODIFIERS only ever caught the first of those.

    2) False positives that no XPath widening can fix. A correctly placed trailing
       comment, '/** javadoc. */ // violation ...', produces an AST identical to the
       misplaced form except for line numbers, and ElementNode exposes only @text to
       XPath - no line information. So MatchXpath cannot tell the two apart.

    A line-oriented RegexpMultiline expresses the rule directly: an annotation-only line,
    or a Javadoc block whose closing '*' '/' ends its line, immediately followed by a line
    that is just a '// ... violation ...' comment. Trailing comments are excluded because
    the comment must start its own line, and lines such as '@Annotation int x;' or
    '@interface Foo {}' are excluded because they are complete declarations rather than
    annotation-only lines.
  -->
  <module name="RegexpMultiline">
    <property name="id" value="violationBetweenAnnotationAndMethod"/>
    <property name="matchAcrossLines" value="true"/>
    <property name="format"
              value="(?m)^[ \t]*(?:@[A-Za-z][\w.]*(?:\([^\n]*\))?[ \t]*)+\n[ \t]*//[^\n]*violation"/>
    <property name="message"
              value="Violation comment must not be placed between an annotation and its target.
Place it before the annotation block instead."/>
  </module>
  <module name="RegexpMultiline">
    <property name="id" value="violationBetweenJavadocAndMethod"/>
    <property name="matchAcrossLines" value="true"/>
    <property name="format"
              value="/\*\*(?:[^*]|\*(?!/))*+\*/[ \t]*\n[ \t]*//[^\n]*violation"/>
    <property name="message"
              value="Violation comment must not be placed between a Javadoc block and its target.
Place it before the Javadoc block instead."/>
  </module>

  <module name="TreeWalker">
    <module name="Regexp">
      <property name="id" value="UnnecessaryOkComment"/>
      <property name="format"
               value="(?i)\/\/\s*ok$"/>
      <property name="illegalPattern" value="true"/>
      <message key="illegal.regexp"
               value="'// ok' comments should have an explanation, or they are unnecessary."/>
    </module>
  </module>
</module>
