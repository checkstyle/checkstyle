<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="haltOnException" value="false"/>

  <property name="cacheFile" value="target/cache_resources"/>

  <!-- Suppressions for resources -->
  <module name="SuppressionFilter">
    <property name="file"
             value="config/checkstyle-resources-suppressions.xml"/>
  </module>
  <module name="FileTabCharacter"/>
  <module name="RegexpSingleline">
    <property name="id" value="noTrailingWhitespace"/>
    <property name="format" value="\s+$"/>
    <property name="message" value="Trailing whitespace is not allowed"/>
  </module>
  <module name="RegexpOnFilename">
    <property name="id" value="resourceFileName"/>
    <property name="folderPattern"
             value="[\\/]src[\\/](it|test)[\\/]resources-(noncompilable?|with-javadoc-error)[\\/]"/>
    <property name="fileNamePattern"
             value="^(package-info.java)|(module-info.java)|(Input\w+\.java)|(Expected\w+\.txt)|(.*\.properties)$"/>
    <property name="match" value="false"/>
    <message key="regexp.filename.mismatch"
           value="All files in the ''src/(it|test)/resources-*'' folders should be named
                 ''Input*.java'' or ''Expected*.java''
                 or ''package-info.java'' or ''module-info.java'' or ''*.properties''."/>
  </module>
  <module name="RegexpOnFilename">
    <property name="id" value="moduleInfoFolderStructure"/>
    <property name="folderPattern"
             value="[\\/]resources-noncompilable[\\/].*[\\/]checks[\\/](?!.*[\\/]module-info[\\/][^\\/]+$)"/>
    <property name="fileNamePattern" value="^module-info\.java$"/>
    <property name="match" value="true"/>
    <message key="regexp.filename.match"
             value="module-info.java files must be located in a ''module-info/&lt;case&gt;/'' folder under the Check''s input directory."/>
  </module>
  <module name="RegexpOnFilename">
    <property name="id" value="siteXmlFileNaming"/>
    <property name="folderPattern"
             value="[\\/]src[\\/]site[\\/].*"/>
    <property name="fileNamePattern" value=".*_.*\.(xml|html)"/>
    <property name="match" value="true"/>
    <message key="regexp.filename.match"
           value="Site XML and HTML files should use hyphens (-) instead of underscores (_) in filenames."/>
  </module>

  <module name="TreeWalker">
    <module name="PackageDeclarationCheck"/>
    <module name="OuterTypeFilenameCheck"/>
  </module>

  <module name="FileLength">
    <property name="max" value="120" />
    <property name="fileExtensions" value="java" />
  </module>

</module>
