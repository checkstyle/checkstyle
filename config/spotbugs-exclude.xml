    <Method name="&lt;init&gt;" returns="void"
            params="com.puppycrawl.tools.checkstyle.api.SeverityLevel"/>
    <Bug pattern="WEM_WEAK_EXCEPTION_MESSAGING"/>
  </Match>
  <!-- The guard identifies the missing identifier AST. -->
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.checks.SuppressWarningsHolder"/>
    <Method name="getIdentifier" returns="java.lang.String"
            params="com.puppycrawl.tools.checkstyle.api.DetailAST"/>
