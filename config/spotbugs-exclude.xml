<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <Match>
    <!-- That code is auto generated -->
    <Package name="~com\.puppycrawl\.tools\.checkstyle\.grammar.*" />
  </Match>
  <Match>
    <!-- see a reason of suppression at #910 -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.UniquePropertiesCheck$UniqueProperties" />
    <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS" />
  </Match>
  <Match>
    <!-- SpotBugs suggests replacing the List field 'order' with a Set because it is
         queried with 'contains'. The field cannot be a Set: it defines the sequence
         in which directive blocks must appear, so element positions matter. Rewriting
         'contains' as 'indexOf(...) >= 0' to hide the membership query is rejected by
         the Qodana inspection ListIndexOfReplaceableByContains. -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.modules.ModuleDirectiveOrderCheck" />
    <Bug pattern="DLC_DUBIOUS_LIST_COLLECTION" />
  </Match>
  <Match>
    <!-- till https://github.com/checkstyle/checkstyle/issues/17933 fails on java11+ -->
    <Class name="com.puppycrawl.tools.checkstyle.Main" />
    <Method name="loadProperties" />
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" />
  </Match>
  <Match>
    <!-- till https://github.com/checkstyle/checkstyle/issues/17933 fails on java11+ -->
    <Class name="com.puppycrawl.tools.checkstyle.PropertyCacheFile" />
    <Method name="load" />
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" />
  </Match>
  <Match>
    <!-- till https://github.com/checkstyle/checkstyle/issues/17933 fails on java11+ -->
    <Class name="com.puppycrawl.tools.checkstyle.PropertyCacheFile" />
    <Method name="persist" />
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" />
  </Match>
  <Match>
    <!-- till https://github.com/checkstyle/checkstyle/issues/17933 fails on java11+ -->
    <Class name="com.puppycrawl.tools.checkstyle.ant.CheckstyleAntTask" />
    <Method name="createOverridingProperties" />
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" />
  </Match>
  <Match>
    <!-- till https://github.com/checkstyle/checkstyle/issues/17933 fails on java11+ -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.OrderedPropertiesCheck" />
    <Method name="processFiltered" />
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" />
  </Match>
  <Match>
    <!-- till https://github.com/checkstyle/checkstyle/issues/17933 fails on java11+ -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.TranslationCheck" />
    <Method name="getTranslationKeys" />
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" />
  </Match>
  <Match>
    <!-- till https://github.com/checkstyle/checkstyle/issues/17933 fails on java11+ -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.UniquePropertiesCheck" />
    <Method name="processFiltered" />
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" />
  </Match>
  <Match>
    <!-- There are empty methods in AbstractCheck, AbstractFileSetCheck,
         AbstractJavadocCheck, and AbstractViolationReporter. Making them
         abstract requires too much boilerplate in subclasses. -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.api.AbstractCheck"/>
      <Class name="com.puppycrawl.tools.checkstyle.api.AbstractFileSetCheck"/>
      <Class name="com.puppycrawl.tools.checkstyle.api.AbstractViolationReporter"/>
      <Class name="com.puppycrawl.tools.checkstyle.checks.javadoc.AbstractJavadocCheck"/>
    </Or>
    <Bug pattern="ACEM_ABSTRACT_CLASS_EMPTY_METHODS"/>
  </Match>
  <Match>
    <!-- Till https://github.com/mebigfatguy/fb-contrib/issues/296
         @Nullable annotation is good idea in general, but requires extra dependencies. -->
    <Bug pattern="AI_ANNOTATION_ISSUES_NEEDS_NULLABLE"/>
  </Match>
  <Match>
    <!-- have never been a case for years, Eclipse does not show any other classes
           inherited from CommonASTWithHiddenTokens -->
    <Class name="com.puppycrawl.tools.checkstyle.DetailAstImpl" />
    <Bug pattern="BC_UNCONFIRMED_CAST" />
  </Match>
  <Match>
    <!-- The structure of frames relies on the AST structure which relies on correct/compilable
           java files. It is ok to have direct casts to subtypes there. Any problems at runtime do
           mean serious problems in the algorithm or AST generation. -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.coding.RequireThisCheck"/>
    <Or>
      <Bug pattern="BC_UNCONFIRMED_CAST"/>
      <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
    </Or>
  </Match>
  <Match>
    <!-- Till https://github.com/mebigfatguy/fb-contrib/issues/309 -->
    <Bug pattern="CE_CLASS_ENVY"/>
  </Match>
  <Match>
    <!-- The two command-line arguments are positional: args[0] is the xdocs directory
         and args[1] is the output file, and their count is checked first. -->
    <Class name="com.puppycrawl.tools.checkstyle.site.SearchIndexGenerator"/>
    <Method name="execute"/>
    <Bug pattern="CLI_CONSTANT_LIST_INDEX"/>
  </Match>
  <Match>
    <!-- These fields are restricted caches which must remain populated until the process ends. -->
    <Bug pattern="PMB_POSSIBLE_MEMORY_BLOAT"/>
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.PackageObjectFactory"/>
      <Class name="com.puppycrawl.tools.checkstyle.checks.SuppressWarningsHolder"/>
    </Or>
  </Match>
  <Match>
    <!-- false positive, beginTree is a kind of constructor for Checks -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.checks.AvoidEscapedUnicodeCharactersCheck" />
      <Class name="com.puppycrawl.tools.checkstyle.checks.coding.RequireThisCheck" />
      <Class name="com.puppycrawl.tools.checkstyle.checks.coding.DeclarationOrderCheck" />
      <Class name="com.puppycrawl.tools.checkstyle.checks.coding.MatchXpathCheck"/>
      <Class name="com.puppycrawl.tools.checkstyle.checks.OuterTypeFilenameCheck" />
      <Class name="com.puppycrawl.tools.checkstyle.checks.regexp.RegexpCheck" />
      <!-- createJavadocNode is private and can not be launched without visitToken -->
      <Class name="com.puppycrawl.tools.checkstyle.checks.javadoc.AbstractJavadocCheck" />
      <Class name=
             "com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocLeadingAsteriskAlignCheck" />
      <!-- currentAst is always assigned in visitToken before super.visitToken triggers
           visitJavadocToken, so it is never actually null when dereferenced -->
      <Class
      name=
      "com.puppycrawl.tools.checkstyle.checks.javadoc.InappropriateJavadocBlockTagsOnFieldCheck" />
      <Class
      name=
      "com.puppycrawl.tools.checkstyle.checks.javadoc.InappropriateJavadocBlockTagsOnTypeCheck" />
      <Class name=
             "com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocLinkFirstOccurrenceCheck" />
      <!-- has only one public method and all initialized in that method -->
      <Class name="com.puppycrawl.tools.checkstyle.checks.regexp.MultilineDetector" />
      <!-- beginProcessing() is kind of c-tor -->
      <Class name="com.puppycrawl.tools.checkstyle.checks.regexp.RegexpMultilineCheck" />
      <Class name="com.puppycrawl.tools.checkstyle.checks.regexp.RegexpSinglelineCheck" />
      <!-- Uses setters to set fields values.
           This is part of the public API, so it's hard to refactor. -->
      <Class name="com.puppycrawl.tools.checkstyle.api.AbstractCheck$FileContext" />
      <Class name="com.puppycrawl.tools.checkstyle.api.AbstractFileSetCheck$FileContext" />
      <!-- We cannot modify fields since we won't have the values
             to create the instance until the setters are called -->
      <Class name="com.puppycrawl.tools.checkstyle.filters.SuppressionSingleFilter"/>
      <Class name="com.puppycrawl.tools.checkstyle.filters.SuppressionXpathSingleFilter"/>
    </Or>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR" />
  </Match>
  <Match>
    <!-- false-positive. See details at https://github.com/checkstyle/checkstyle/pull/6343 -->
    <Class
    name="com.puppycrawl.tools.checkstyle.checks.OrderedPropertiesCheck$SequencedProperties"/>
    <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
  </Match>
  <Match>
    <!-- Swing classes are Serializable only through JFrame and AbstractTableModel, and are
         never serialized. Their models are transient, so they do not need to be Serializable. -->
    <Or>
      <And>
        <Class name="com.puppycrawl.tools.checkstyle.gui.MainFrame"/>
        <Field name="model"/>
      </And>
      <And>
        <Class name="com.puppycrawl.tools.checkstyle.gui.TreeTableModelAdapter"/>
        <Field name="treeTableModel"/>
      </And>
    </Or>
    <Bug pattern="NFF_NON_FUNCTIONAL_FIELD"/>
  </Match>
  <Match>
    <!-- It is better to catch all exceptions since it can throw a runtime exception. -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.TranslationCheck"/>
    <Method name="getTranslationKeys"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>
  <Match>
    <!-- Properties.load can throw a runtime exception on malformed input. -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.UniquePropertiesCheck"/>
    <Method name="processFiltered"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>
  <Match>
    <!-- Creates too many false positives on classes stored in sets/maps
         which require multiple objects to be stored. -->
    <Bug pattern="FCBL_FIELD_COULD_BE_LOCAL"/>
  </Match>
  <Match>
    <!-- Runtime#exit(int) used in Main#main to return the exit code to the system. -->
    <Class name="com.puppycrawl.tools.checkstyle.Main"/>
    <Bug pattern="MDM_RUNTIME_EXIT_OR_HALT"/>
  </Match>
  <Match>
    <!-- False positive as we override and enforce final so no more overrides. -->
    <Bug pattern="COM_COPIED_OVERRIDDEN_METHOD"/>
    <Class name="com.puppycrawl.tools.checkstyle.checks.javadoc.AbstractJavadocCheck"/>
    <Method name="finishTree"/>
  </Match>
  <Match>
    <!-- Check is broken and does not clearly report where the fault is.
         Suppressed until https://github.com/mebigfatguy/fb-contrib/issues/453 -->
    <Bug pattern="WOC_WRITE_ONLY_COLLECTION_FIELD"/>
  </Match>
  <Match>
    <!-- Creates too many false positives on orElseGet calls. -->
    <Bug pattern="OI_OPTIONAL_ISSUES_USES_ORELSEGET_WITH_NULL"/>
  </Match>
  <Match>
    <!-- Must scan entire list to find the best item. -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.imports.ImportOrderCheck"/>
    <Method name="findGroupNumber"/>
    <Bug pattern="SLS_SUSPICIOUS_LOOP_SEARCH"/>
  </Match>
  <Match>
    <!-- symbolCodes is the String value of the property, which is documented and has its
         default value on the field. It is parsed into code points and ranges once it is set. -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.coding.IllegalSymbolCheck"/>
    <Method name="parseSymbolCodes"/>
    <Bug pattern="STT_STRING_PARSING_A_FIELD"/>
  </Match>
  <Match>
    <!-- Better to use DetailAstImpl here to avoid needless dependency of API package. -->
    <Class name="com.puppycrawl.tools.checkstyle.JavaAstVisitor"/>
    <Method name="addLastSibling"/>
    <Bug pattern="OCP_OVERLY_CONCRETE_PARAMETER"/>
  </Match>
  <Match>
    <!-- For recursive code, the size is difficult to determine.
         It is better to use the default allocation size. -->
    <Class name="com.puppycrawl.tools.checkstyle.JavaAstVisitor"/>
    <Bug pattern="PSC_PRESIZE_COLLECTIONS"/>
  </Match>
  <Match>
    <!-- These classes do not represent value objects requiring custom equals methods. -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.api.BeforeExecutionFileFilterSet"/>
      <Class name="com.puppycrawl.tools.checkstyle.api.Comment"/>
      <Class name="com.puppycrawl.tools.checkstyle.api.FilterSet"/>
      <Class name="com.puppycrawl.tools.checkstyle.checks.indentation.IndentLevel"/>
      <Class name="com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocTag"/>
    </Or>
    <Bug pattern="IMC_IMMATURE_CLASS_NO_EQUALS"/>
  </Match>
  <!-- After https://github.com/checkstyle/checkstyle/issues/11140
       there should be one section per one bug pattern, with list of allowed classes or methods -->
  <Match>
    <!-- RootModule.destroy() is public API, IOException appeared long time after this
         method become used in all solutions, we decided to keep it unchanged to not
         cause migration problems for users -->
    <Class name="com.puppycrawl.tools.checkstyle.Checker"/>
    <Method name="destroy"/>
    <Bug pattern="EXS_EXCEPTION_SOFTENING_NO_CHECKED"/>
  </Match>
  <Match>
    <!-- Wrapping checked exceptions into CheckstyleException or runtime exceptions is
         intentional when conforming to framework APIs or make sure that context that caused
         it is preserved in wrapping Exception. -->
    <Bug pattern="EXS_EXCEPTION_SOFTENING_NO_CONSTRAINTS"/>
  </Match>
  <Match>
    <!-- It is normal practice to have public/protected method to be named in good way,
         and have private method named the same to do all/majority of work. Second method
         is static so means that logic is stateless that is good marker. -->
    <Class name="com.puppycrawl.tools.checkstyle.api.AbstractViolationReporter"/>
    <Method name="getMessageBundle"/>
    <Bug pattern="MOM_MISLEADING_OVERLOAD_MODEL"/>
  </Match>
  <Match>
    <Bug pattern="
      IMC_IMMATURE_CLASS_NO_TOSTRING,
      " />
  </Match>
  <Match>
    <!-- Till https://github.com/spotbugs/spotbugs/issues/1601 -->
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <!-- RootModule.destroy() is public API and cannot declare IOException, so a cache
         persist failure is wrapped in IllegalStateException, see
         CheckerTest#testDestroyCheckerWithWrongCacheFileNameLength -->
    <Class name="com.puppycrawl.tools.checkstyle.Checker"/>
    <Method name="destroy"/>
    <Bug pattern="EXS_EXCEPTION_SOFTENING_NO_CHECKED"/>
  </Match>
  <Match>
    <!-- until https://github.com/checkstyle/checkstyle/issues/22797 -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.checks.indentation.CatchHandler"/>
      <Class name="com.puppycrawl.tools.checkstyle.checks.indentation.LambdaHandler"/>
    </Or>
    <Bug pattern="FCCD_FIND_CLASS_CIRCULAR_DEPENDENCY"/>
  </Match>
  <Match>
    <!-- Swing TreeTable architecture requires mutual references between tree table,
         presentation model, and cell renderers. -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.gui.ListToTreeSelectionModelWrapper"/>
      <Class name="com.puppycrawl.tools.checkstyle.gui.ParseTreeTablePresentation"/>
      <Class name="com.puppycrawl.tools.checkstyle.gui.TreeTableCellRenderer"/>
    </Or>
    <Bug pattern="FCCD_FIND_CLASS_CIRCULAR_DEPENDENCY"/>
  </Match>
  <Match>
    <!-- until https://github.com/checkstyle/checkstyle/issues/22796 -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.utils.XpathUtil"/>
      <Class name="com.puppycrawl.tools.checkstyle.xpath.RootNode"/>
    </Or>
    <Bug pattern="FCCD_FIND_CLASS_CIRCULAR_DEPENDENCY"/>
  </Match>
  <Match>
    <!-- Printing stack trace is intended for Main#main on fatal CheckstyleException. -->
    <Class name="com.puppycrawl.tools.checkstyle.Main"/>
    <Method name="main"/>
    <Bug pattern="IMC_IMMATURE_CLASS_PRINTSTACKTRACE"/>
  </Match>
  <Match>
    <!-- Checks and filters are treated differently. -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.Checker"/>
      <Class name="com.puppycrawl.tools.checkstyle.TreeWalker"/>
    </Or>
    <Bug pattern="ITC_INHERITANCE_TYPE_CHECKING"/>
  </Match>
  <Match>
    <!-- until https://github.com/checkstyle/checkstyle/issues/4409 -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.api.AbstractCheck"/>
      <Class name="com.puppycrawl.tools.checkstyle.api.AbstractFileSetCheck"/>
      <Class name="com.puppycrawl.tools.checkstyle.checks.javadoc.AbstractJavadocCheck"/>
    </Or>
    <Bug pattern="PMB_INSTANCE_BASED_THREAD_LOCAL"/>
  </Match>
  <Match>
    <!-- Public constructors of Checkstyle public API classes.
         Constructors of public classes are ok to be public. -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.DefaultLogger"/>
      <Class name="com.puppycrawl.tools.checkstyle.PackageObjectFactory"/>
      <Class name="com.puppycrawl.tools.checkstyle.api.Violation"/>
      <Class name="com.puppycrawl.tools.checkstyle.xpath.XpathQueryGenerator"/>
    </Or>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="OPM_OVERLY_PERMISSIVE_METHOD"/>
  </Match>
  <Match>
    <!-- Public methods of Checkstyle public API classes.
         Their visibility cannot be reduced without breaking backward compatibility
         or subclassing contracts. -->
    <Class name="com.puppycrawl.tools.checkstyle.Checker"/>
    <Or>
      <Method name="addBeforeExecutionFileFilter"/>
      <Method name="addFileSetCheck"/>
      <Method name="addFilter"/>
    </Or>
    <Bug pattern="OPM_OVERLY_PERMISSIVE_METHOD"/>
  </Match>
  <Match>
    <!-- Public methods of Checkstyle public API classes. -->
    <Class name="com.puppycrawl.tools.checkstyle.ConfigurationLoader"/>
    <Method name="loadConfiguration"/>
    <Bug pattern="OPM_OVERLY_PERMISSIVE_METHOD"/>
  </Match>
  <Match>
    <!-- Public methods of Checkstyle public API classes. -->
    <Class name="com.puppycrawl.tools.checkstyle.api.FileContents"/>
    <Or>
      <Method name="lineIsBlank"/>
      <Method name="lineIsComment"/>
      <Method name="reportBlockComment"/>
      <Method name="reportSingleLineComment"/>
    </Or>
    <Bug pattern="OPM_OVERLY_PERMISSIVE_METHOD"/>
  </Match>
  <Match>
    <!-- Methods designed for subclass extension in checks. -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.javadoc.AbstractJavadocCheck"/>
    <Or>
      <Method name="acceptJavadocWithNonTightHtml"/>
      <Method name="beginJavadocTree"/>
      <Method name="finishJavadocTree"/>
      <Method name="leaveJavadocToken"/>
    </Or>
    <Bug pattern="OPM_OVERLY_PERMISSIVE_METHOD"/>
  </Match>
  <Match>
    <!-- Utility methods of Checkstyle utility classes. -->
    <Class name="com.puppycrawl.tools.checkstyle.utils.CommonUtil"/>
    <Or>
      <Method name="getResourceFromClassPath"/>
      <Method name="getWebOrFileProtocolUri"/>
      <Method name="isIdentifier"/>
    </Or>
    <Bug pattern="OPM_OVERLY_PERMISSIVE_METHOD"/>
  </Match>
  <Match>
    <!-- Utility methods of Checkstyle utility classes. -->
    <Class name="com.puppycrawl.tools.checkstyle.utils.BlockCommentPosition"/>
    <Or>
      <Method name="isOnAnnotationDef"/>
      <Method name="isOnAnnotationField"/>
      <Method name="isOnClass"/>
      <Method name="isOnCompactConstructor"/>
      <Method name="isOnConstructor"/>
      <Method name="isOnEnum"/>
      <Method name="isOnEnumConstant"/>
      <Method name="isOnField"/>
      <Method name="isOnInterface"/>
      <Method name="isOnMethod"/>
      <Method name="isOnRecord"/>
    </Or>
    <Bug pattern="OPM_OVERLY_PERMISSIVE_METHOD"/>
  </Match>
  <Match>
    <!-- Swing TreeModel API requires passing 'this' as event source -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.gui.ParseTreeTableModel"/>
    </Or>
    <Bug pattern="SPP_PASSING_THIS_AS_PARM"/>
  </Match>
  <Match>
    <!-- This is not possible to fix because if we initialize this in constructor or in
          field itself pitest will be failed
          https://github.com/checkstyle/checkstyle/pull/13269 -->
    <Class
    name="com.puppycrawl.tools.checkstyle.checks.header.AbstractHeaderCheck"/>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
  <Match>
    <!-- there is strict order of method executions, call in misorder will result in failure -->
    <Class name="com.puppycrawl.tools.checkstyle.AbstractAutomaticBean"/>
    <Method name="setupChild"/>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
  <Match>
    <!-- previousReference is always assigned by beginJavadocTree() before
         visitJavadocToken() is invoked for any @see tag; the Javadoc check
         lifecycle guarantees a strict order of method executions. Guarding
         the field with a null check here would add an unreachable branch. -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocSeeTagOrderCheck"/>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
  <Match>
    <!-- external projects inherits from it so it should not be changed  -->
    <Or>
      <Class name="com.puppycrawl.tools.checkstyle.Checker"/>
      <Class name="com.puppycrawl.tools.checkstyle.DefaultLogger"/>
      <Class name="com.puppycrawl.tools.checkstyle.PackageObjectFactory"/>
      <Class name="com.puppycrawl.tools.checkstyle.XmlLoader"/>
    </Or>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <Match>
    <!-- conflicts with PRMC_POSSIBLY_REDUNDANT_METHOD_CALLS -->
    <Class name="com.puppycrawl.tools.checkstyle.checks.imports.PkgImportControl"/>
    <Method name="matchesAtFrontNoRegex"/>
    <Bug pattern="BAS_BLOATED_ASSIGNMENT_SCOPE"/>
  </Match>

  <!-- Suppress PRMC_POSSIBLY_REDUNDANT_METHOD_CALLS -->
  <!-- false positive: NakedReceiverMutator causes unkillable mutations -->
  <!-- until https://github.com/checkstyle/checkstyle/issues/16979 -->
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.JavaAstVisitor" />
    <Bug pattern="PRMC_POSSIBLY_REDUNDANT_METHOD_CALLS" />
  </Match>
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.JavaAstVisitor$DetailAstPair" />
    <Bug pattern="PRMC_POSSIBLY_REDUNDANT_METHOD_CALLS" />
  </Match>

  <!-- Suppress AFBR_ABNORMAL_FINALLY_BLOCK_RETURN -->
  <!-- false positive: finally blocks contain no return/exit, bytecode analysis artifact -->
  <!-- until https://github.com/spotbugs/spotbugs-maven-plugin/issues/806 -->
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.Main" />
    <Bug pattern="AFBR_ABNORMAL_FINALLY_BLOCK_RETURN" />
  </Match>
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.ant.CheckstyleAntTask" />
    <Bug pattern="AFBR_ABNORMAL_FINALLY_BLOCK_RETURN" />
  </Match>
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.gui.ListToTreeSelectionModelWrapper" />
    <Bug pattern="AFBR_ABNORMAL_FINALLY_BLOCK_RETURN" />
  </Match>

  <!-- Suppress CC_CYCLOMATIC_COMPLEXITY -->
  <!-- false positive: necessary complexity in switch-based visitor pattern -->
  <!-- until https://github.com/spotbugs/spotbugs-maven-plugin/issues/806 -->
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.checks.coding.FinalLocalVariableCheck" />
    <Method name="visitToken" />
    <Bug pattern="CC_CYCLOMATIC_COMPLEXITY" />
  </Match>
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.checks.coding.RequireThisCheck" />
    <Method name="getClassFrameWhereViolationIsFound" />
    <Bug pattern="CC_CYCLOMATIC_COMPLEXITY" />
  </Match>

  <!-- Suppress PSC_PRESIZE_COLLECTIONS -->
  <!-- until https://github.com/spotbugs/spotbugs-maven-plugin/issues/806 -->
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.SarifLogger" />
    <Method name="generateRules" />
    <Bug pattern="PSC_PRESIZE_COLLECTIONS" />
  </Match>
  <!-- false positive: tree traversal with unknown result size -->
  <!-- until https://github.com/spotbugs/spotbugs-maven-plugin/issues/806 -->
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocMethodCheck" />
    <Method name="findTokensInAstByType" />
    <Bug pattern="PSC_PRESIZE_COLLECTIONS" />
  </Match>

  <!-- false positive: tree traversal with unknown result size -->
  <!-- until https://github.com/spotbugs/spotbugs-maven-plugin/issues/806 -->
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.checks.whitespace.SingleSpaceSeparatorCheck" />
    <Method name="visitEachToken" />
    <Bug pattern="PSC_PRESIZE_COLLECTIONS" />
  </Match>

  <!-- it has xdoc annotation, we need to reconsider it after we finalize our xdoc generation -->
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.checks.header.MultiFileRegexpHeaderCheck" />
    <Field name="headerFiles" />
    <Bug pattern="SPP_FIELD_COULD_BE_STATIC" />
  </Match>
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.checks.coding.DeclarationOrderCheck$ScopeState" />
    <Field name="currentScopeState" />
    <Bug pattern="SPP_FIELD_COULD_BE_STATIC" />
  </Match>
  <Match>
    <Class name="com.puppycrawl.tools.checkstyle.Main$CliOptions" />
    <Field name="suppressionLineColumnNumber" />
    <Bug pattern="SPP_FIELD_COULD_BE_STATIC" />
  </Match>
