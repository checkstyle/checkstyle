<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionXpathFilter Experimental Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2_xpath_experimental.dtd">

<suppressions>
  <!-- Tone down the checking for test code -->
  <suppress-xpath checks="NPathComplexity"
                   query="//CLASS_DEF[./IDENT[@text='XdocsPagesTest']]
                           //METHOD_DEF[./IDENT[@text='validateCheckSection'
                                or @text='getModulePropertyExpectedValue']]"/>
  <suppress-xpath checks="CyclomaticComplexity"
                   query="//CLASS_DEF[./IDENT[@text='XdocsPagesTest']]//METHOD_DEF"/>
  <!-- Suppressions from PMD configuration -->
  <!-- JavadocMethodCheck - deprecated -->
  <suppress-xpath checks="CyclomaticComplexity"
    query="//CLASS_DEF[./IDENT[@text='JavadocMethodCheck'
                     or @text='CustomImportOrderCheck']]//METHOD_DEF"/>
  <!-- there are 3 thrown and all of them could be caused by xml parsing -->
  <suppress-xpath checks="ThrowsCount"
                  query="//CLASS_DEF[./IDENT[@text='XmlMetaReader']]
                        //METHOD_DEF[./IDENT[@text='read']]/LITERAL_THROWS"/>

  <!-- fillChecksFromJavadocPackage registers every bundled javadoc check, so a large
       number of executable statements is expected. -->
  <suppress-xpath
          files="PackageObjectFactory.java"
          checks="ExecutableStatementCount"
          query="//METHOD_DEF[./IDENT[@text='fillChecksFromJavadocPackage']]"/>

  <!-- Property orderByIncreasingParameterCount of ConstructorsDeclarationGrouping conflicts
  with CustomDeclarationOrder.CustomDeclarationOrder intentionally keeps publicly usable
  constructors before private implementation details, even if it breaks constructor ordering
  by params for private constructors.      -->
  <suppress-xpath
          files="IndentLevel.java"
          checks="ConstructorsDeclarationGroupingCheck"
          query="//CTOR_DEF[./IDENT[@text='IndentLevel']][./MODIFIERS/LITERAL_PRIVATE]"/>
</suppressions>
