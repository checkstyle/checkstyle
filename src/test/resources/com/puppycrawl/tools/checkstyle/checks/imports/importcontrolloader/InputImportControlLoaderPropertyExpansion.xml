<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
    "-//Checkstyle//DTD ImportControl Configuration 1.5//EN"
    "https://checkstyle.org/dtds/import_control_1_5.dtd">

<import-control pkg="${ic.loader.root}.example">
  <subpackage name="${ic.loader.sub}">
    <allow pkg="${ic.loader.allowed}"/>
    <disallow class="${ic.loader.clazz}"/>
    <allow module="${ic.loader.module}"/>
  </subpackage>
</import-control>
