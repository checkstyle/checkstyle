<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
    "-//Checkstyle//DTD ImportControl Configuration 1.5//EN"
    "https://checkstyle.org/dtds/import_control_1_5.dtd">

<import-control pkg="com.example">
  <subpackage name="a$b">
    <allow pkg="literal.dollar"/>
  </subpackage>
  <subpackage name="my$$pkg">
    <allow pkg="escaped.dollar"/>
  </subpackage>
  <file name="Trailing$">
    <allow pkg="trailing.dollar"/>
  </file>
</import-control>
