<?xml version="1.0" encoding="UTF-8"?>
<document xmlns="http://maven.apache.org/XDOC/2.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/XDOC/2.0 https://maven.apache.org/xsd/xdoc-2.0.xsd">
  <head>
    <title>AvoidModuleImport</title>
  </head>
  <body>
    <section name="AvoidModuleImport">
      <macro name="since">
        <param name="modulePath"
               value="src/main/java/com/puppycrawl/tools/checkstyle/checks/imports/AvoidModuleImportCheck.java"/>
      </macro>
      <macro name="sitetoc">
        <param name="modulePath"
               value="src/main/java/com/puppycrawl/tools/checkstyle/checks/imports/AvoidModuleImportCheck.java"/>
      </macro>
      <subsection name="Description" id="AvoidModuleImport_Description">
        <macro name="description">
          <param name="modulePath"
                value="src/main/java/com/puppycrawl/tools/checkstyle/checks/imports/AvoidModuleImportCheck.java"/>
        </macro>
      </subsection>

      <subsection name="Properties" id="AvoidModuleImport_Properties">
        <div class="wrapper">
          <macro name="properties">
            <param name="modulePath"
                   value="src/main/java/com/puppycrawl/tools/checkstyle/checks/imports/AvoidModuleImportCheck.java"/>
          </macro>
        </div>
      </subsection>

      <subsection name="Examples" id="AvoidModuleImport_Examples">
        <p id="Example1-config">
          To configure the check:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources-noncompilable/com/puppycrawl/tools/checkstyle/checks/imports/avoidmoduleimport/Example1.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example1-code">
          Example:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources-noncompilable/com/puppycrawl/tools/checkstyle/checks/imports/avoidmoduleimport/Example1.java"/>
          <param name="type" value="code"/>
        </macro><hr class="example-separator"/>
        <p id="Example2-config">
          To configure the check to allow module imports for
          <code>java.base and java.sql</code>:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources-noncompilable/com/puppycrawl/tools/checkstyle/checks/imports/avoidmoduleimport/Example2.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example2-code">
          Example:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources-noncompilable/com/puppycrawl/tools/checkstyle/checks/imports/avoidmoduleimport/Example2.java"/>
          <param name="type" value="code"/>
        </macro><hr class="example-separator"/>
        <p id="Example3-config">
          To configure the check to allow at most one module import:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources-noncompilable/com/puppycrawl/tools/checkstyle/checks/imports/avoidmoduleimport/Example3.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example3-code">
          Example:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources-noncompilable/com/puppycrawl/tools/checkstyle/checks/imports/avoidmoduleimport/Example3.java"/>
          <param name="type" value="code"/>
        </macro>
      </subsection>

      <subsection name="Example of Usage" id="AvoidModuleImport_Example_of_Usage">
        <ul>
          <li>
            <a href="https://github.com/search?q=path%3Aconfig%20path%3A**%2Fcheckstyle-checks.xml+repo%3Acheckstyle%2Fcheckstyle+AvoidModuleImport">
            Checkstyle Style</a>
          </li>
        </ul>
      </subsection>
      <subsection name="Violation Messages" id="AvoidModuleImport_Violation_Messages">
        <macro name="violation-messages">
          <param name="checkName" value="AvoidModuleImport"/>
        </macro>
        <p>
          All messages can be customized if the default message doesn't suit you.
          Please <a href="../../config.html#Custom_messages">see the documentation</a>
          to learn how to.
        </p>
      </subsection>
      <subsection name="Fully Qualified Name" id="AvoidModuleImport_Fully_Qualified_Name">
        <p> com.puppycrawl.tools.checkstyle.checks.imports.AvoidModuleImportCheck</p>
        <p>
              Use this fully qualified class name in configuration when an exact class reference is
              required.
        </p>
      </subsection>

      <subsection name="Parent Module" id="AvoidModuleImport_Parent_Module">
        <macro name="parent-module">
          <param name="moduleName" value="AvoidModuleImport"/>
        </macro>
      </subsection>
    </section>
  </body>
</document>
