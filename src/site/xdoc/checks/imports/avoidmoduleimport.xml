      <subsection name="Examples" id="AvoidModuleImport_Examples">
        <p id="Example1-config">
          To configure the check:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-xml">
&lt;module name="Checker"&gt;
  &lt;module name="TreeWalker"&gt;
    &lt;module name="AvoidModuleImport"/&gt;
  &lt;/module&gt;
&lt;/module&gt;
</code></pre></div>
        <p id="Example1-code">
          Example:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-java">
import module java.base;
// violation above 'Using the 'import module' form of import should be avoided'
import module java.sql;
// violation above 'Using the 'import module' form of import should be avoided'
public class Example1 {

  void getNames() {
    List&lt;String&gt; names = new ArrayList&lt;&gt;();
    names.add("foo");
    names.add("bar");
    System.out.println(names);
  }
}
</code></pre></div><hr class="example-separator"/>
        <p id="Example2-config">
          To configure the check to allow module imports for
          <code>java.base and java.sql</code>:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-xml">
&lt;module name="Checker"&gt;
  &lt;module name="TreeWalker"&gt;
    &lt;module name="AvoidModuleImport"&gt;
      &lt;property name="excludes" value="java.base, java.sql"/&gt;
    &lt;/module&gt;
  &lt;/module&gt;
&lt;/module&gt;
</code></pre></div>
        <p id="Example2-code">
          Example:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-java">
import module java.base;

import module java.sql;

public class Example2 {

  void getNames() {
    List&lt;String&gt; names = new ArrayList&lt;&gt;();
    names.add("foo");
    names.add("bar");
    System.out.println(names);
  }
}
</code></pre></div><hr class="example-separator"/>
        <p id="Example3-config">
          To configure the check to allow at most one module import:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-xml">
&lt;module name="Checker"&gt;
  &lt;module name="TreeWalker"&gt;
    &lt;module name="AvoidModuleImport"&gt;
      &lt;property name="maxAllowedModuleImports" value="1"/&gt;
    &lt;/module&gt;
  &lt;/module&gt;
&lt;/module&gt;
</code></pre></div>
        <p id="Example3-code">
          Example:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-java">
import module java.base;

import module java.sql;
// violation above 'Only '1' module import is allowed per file.'
public class Example3 {

  void getNames() {
    List&lt;String&gt; names = new ArrayList&lt;&gt;();
    names.add("foo");
    names.add("bar");
    System.out.println(names);
  }
}
</code></pre></div>
