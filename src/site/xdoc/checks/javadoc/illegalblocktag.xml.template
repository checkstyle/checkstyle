  <body>
    <section name="IllegalBlockTag">
      <macro name="since">
        <param name="modulePath"
               value="src/main/java/com/puppycrawl/tools/checkstyle/checks/javadoc/IllegalBlockTagCheck.java"/>
      </macro>
      <macro name="sitetoc">
        <param name="modulePath"
               value="src/main/java/com/puppycrawl/tools/checkstyle/checks/javadoc/IllegalBlockTagCheck.java"/>
      </macro>
      <subsection name="Description" id="IllegalBlockTag_Description">
        <macro name="description">
            <param name="modulePath"
                   value="src/main/java/com/puppycrawl/tools/checkstyle/checks/javadoc/IllegalBlockTagCheck.java"/>
        </macro>
      </subsection>

      <subsection name="Properties" id="IllegalBlockTag_Properties">
        <div class="wrapper">
          <macro name="properties">
            <param name="modulePath"
                   value="src/main/java/com/puppycrawl/tools/checkstyle/checks/javadoc/IllegalBlockTagCheck.java"/>
          </macro>
        </div>
      </subsection>

      <subsection name="Examples" id="IllegalBlockTag_Examples">
        <p id="Example1-config">
          Example of default Check configuration that does nothing.
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/illegalblocktag/Example1.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example1-code">
        Example:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/illegalblocktag/Example1.java"/>
          <param name="type" value="code"/>
        </macro><hr class="example-separator"/>
        <p id="Example2-config">
          To configure Check to forbid the <code>@todo</code> block tag
          wherever it appears. The default <code>tagTextPattern</code> is
          <code>^$</code>, so any non-empty tag text is a violation.
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/illegalblocktag/Example2.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example2-code">
        Example:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/illegalblocktag/Example2.java"/>
          <param name="type" value="code"/>
        </macro><hr class="example-separator"/>
        <p id="Example3-config">
          To configure Check to report <code>@since</code> tags whose text
          does not match a digital version pattern (default tokens: types and methods).
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/illegalblocktag/Example3.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example3-code">
        Example:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/illegalblocktag/Example3.java"/>
          <param name="type" value="code"/>
        </macro><hr class="example-separator"/>
        <p id="Example4-config">
          Same as Example 3, but only type tokens so method-level
          <code>@since</code> tags are ignored.
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/illegalblocktag/Example4.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example4-code">
        Example:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/illegalblocktag/Example4.java"/>
          <param name="type" value="code"/>
        </macro>
      </subsection>

      <subsection name="Example of Usage" id="IllegalBlockTag_Example_of_Usage">
        <ul>
