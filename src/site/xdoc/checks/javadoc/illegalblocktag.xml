   * some doc
   * @todo remove
   * @since 1.1-beta
   */
  void testMethod1() {}

  /**
   * some doc
   * @since 1.6
   */
  void testMethod2() {}

  /**
   * some doc
   * @todo later
   * @since 1.2
   */
  void testMethod3() {}

}
</code></pre></div>
