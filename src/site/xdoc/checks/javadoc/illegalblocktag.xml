      <subsection name="Examples" id="IllegalBlockTag_Examples">
        <p id="Example1-config">
          Example of default Check configuration that does nothing.
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-xml">
&lt;module name="Checker"&gt;
  &lt;module name="TreeWalker"&gt;
    &lt;module name="IllegalBlockTag"/&gt;
  &lt;/module&gt;
&lt;/module&gt;
</code></pre></div>
        <p id="Example1-code">
        Example:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-java">
/**
 * some doc
 * @todo something
 */
public class Example1 {
  /**
   * some doc
   * @somesince 1.1-betta
   */
  void testMethod1() {}
}
</code></pre></div><hr class="example-separator"/>
        <p id="Example2-config">
          To configure Check to forbid the <code>@todo</code> block tag
          wherever it appears. The default <code>tagTextPattern</code> matches
          nothing, so any presence of the tag is a violation.
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-xml">
&lt;module name="Checker"&gt;
  &lt;module name="TreeWalker"&gt;
    &lt;module name="IllegalBlockTag"&gt;
      &lt;property name="tag" value="@todo"/&gt;
    &lt;/module&gt;
  &lt;/module&gt;
&lt;/module&gt;
</code></pre></div>
        <p id="Example2-code">
        Example:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-java">
/**
 * some doc
 * @todo remove
 */
public class Example2 {
  // violation 3 lines above 'Block tag 'todo' is matched illegal pattern'
  /**
   * some doc
   * @since 1.0
   */
  void testMethod1() {}
}
</code></pre></div><hr class="example-separator"/>
        <p id="Example3-config">
          To configure Check to report <code>@somesince</code> tags whose text
          does not match a digital version pattern on types and methods.
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-xml">
&lt;module name="Checker"&gt;
  &lt;module name="TreeWalker"&gt;
    &lt;module name="IllegalBlockTag"&gt;
      &lt;property name="tokens"
                value="INTERFACE_DEF, CLASS_DEF, ENUM_DEF,
                ANNOTATION_DEF, RECORD_DEF, METHOD_DEF" /&gt;
      &lt;property name="tag" value="@somesince"/&gt;
      &lt;property name="tagTextPattern" value="^[1-9\\.]+$"/&gt;
    &lt;/module&gt;
  &lt;/module&gt;
&lt;/module&gt;
</code></pre></div>
        <p id="Example3-code">
        Example:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-java">
public class Example3 {
  /**
   * some doc
   * @somesince 1.1-betta
   */
  void testMethod1() {}
  // violation 3 lines above 'Block tag 'somesince' is matched illegal pattern'
  /**
   * some doc
   * @somesince 1.2
   */
  void testMethod2() {}
}
</code></pre></div>
      </subsection>

