<?xml version="1.0" encoding="UTF-8"?>
<document xmlns="http://maven.apache.org/XDOC/2.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/XDOC/2.0 https://maven.apache.org/xsd/xdoc-2.0.xsd">
  <head>
    <title>JavadocRegexp</title>
  </head>
  <body>
    <section name="JavadocRegexp">
      <macro name="since">
        <param name="modulePath"
               value="src/main/java/com/puppycrawl/tools/checkstyle/checks/javadoc/JavadocRegexpCheck.java"/>
      </macro>
      <macro name="sitetoc">
        <param name="modulePath"
               value="src/main/java/com/puppycrawl/tools/checkstyle/checks/javadoc/JavadocRegexpCheck.java"/>
      </macro>
      <subsection name="Description" id="JavadocRegexp_Description">
        <macro name="description">
          <param name="modulePath"
                value="src/main/java/com/puppycrawl/tools/checkstyle/checks/javadoc/JavadocRegexpCheck.java"/>
        </macro>
      </subsection>

      <subsection name="Properties" id="JavadocRegexp_Properties">
        <div class="wrapper">
          <macro name="properties">
            <param name="modulePath"
                   value="src/main/java/com/puppycrawl/tools/checkstyle/checks/javadoc/JavadocRegexpCheck.java"/>
          </macro>
        </div>
      </subsection>

      <subsection name="Examples" id="JavadocRegexp_Examples">
        <p id="Example1-config">
          To configure the check with default settings that do not perform any validation:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/javadocregexp/Example1.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example1-code">Example:</p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/javadocregexp/Example1.java"/>
          <param name="type" value="code"/>
        </macro><hr class="example-separator"/>
        <p id="Example2-config">
          To configure the check to find closing &lt;/p&gt; tags in raw Javadoc source:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/javadocregexp/Example2.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example2-code">Example:</p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/javadocregexp/Example2.java"/>
          <param name="type" value="code"/>
        </macro><hr class="example-separator"/>
        <p id="Example3-config">
          To configure the check to find uppercase abbreviation 'AKA' in text visible
          in generated Javadoc HTML pages:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/javadocregexp/Example3.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example3-code">Example:</p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/javadocregexp/Example3.java"/>
          <param name="type" value="code"/>
        </macro><hr class="example-separator"/>
        <p id="Example4-config">
          To configure the check to find abbreviation 'aka' in text visible
          in generated Javadoc HTML pages regardless of case:
        </p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/javadocregexp/Example4.java"/>
          <param name="type" value="config"/>
        </macro>
        <p id="Example4-code">Example:</p>
        <macro name="example">
          <param name="path"
                 value="resources/com/puppycrawl/tools/checkstyle/checks/javadoc/javadocregexp/Example4.java"/>
          <param name="type" value="code"/>
        </macro>
      </subsection>

      <subsection name="Example of Usage" id="JavadocRegexp_Example_of_Usage">
        <ul>
          <li>
            <a href="https://github.com/search?q=path%3Aconfig%20path%3A**%2Fcheckstyle-checks.xml+repo%3Acheckstyle%2Fcheckstyle+JavadocRegexp">
              Checkstyle Style</a>
          </li>
          <li>
            <a href="https://github.com/search?q=path%3Asrc%2Fmain%2Fresources%20path%3A**%2Fdoc_comments_checks.xml+repo%3Acheckstyle%2Fcheckstyle+JavadocRegexp">
              Documentation Comments Style</a>
          </li>
        </ul>
      </subsection>

      <subsection name="Violation Messages" id="JavadocRegexp_Violation_Messages">
        <macro name="violation-messages">
          <param name="checkName" value="JavadocRegexp"/>
        </macro>
        <p>
          All messages can be customized if the default message doesn't suit you.
          Please <a href="../../config.html#Custom_messages">see the documentation</a>
          to learn how to.
        </p>
      </subsection>

      <subsection name="Fully Qualified Name" id="JavadocRegexp_Fully_Qualified_Name">
        <p>com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocRegexpCheck</p>
        <p>
              Use this fully qualified class name in configuration when an exact class reference is
              required.
        </p>
      </subsection>

      <subsection name="Parent Module" id="JavadocRegexp_Parent_Module">
        <macro name="parent-module">
          <param name="moduleName" value="JavadocRegexp"/>
        </macro>
      </subsection>
    </section>
  </body>
</document>
