      <subsection name="Description" id="DuplicateConditionIfChain_Description">
        <div>
          Checks for duplicate condition expressions in <code>if ... else if</code> chains.
        </div>
      </subsection>

      <subsection name="Examples" id="DuplicateConditionIfChain_Examples">
        <p id="Example1-config">
          To configure the check:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-xml">
&lt;module name="Checker"&gt;
  &lt;module name="TreeWalker"&gt;
    &lt;module name="DuplicateConditionIfChain"/&gt;
  &lt;/module&gt;
&lt;/module&gt;
</code></pre></div>
        <p id="Example1-code">
          Example:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-java">
class Example1 {
  void foo(int x) {
    if (x &gt; 0) {
      System.out.println("positive");
    } else if (x &gt; 0) { // violation 'Duplicate condition expression identical to the condition at line 4'
      System.out.println("positive again");
    }
  }
}
</code></pre></div>
      </subsection>

