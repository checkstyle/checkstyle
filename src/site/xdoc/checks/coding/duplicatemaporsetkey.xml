      <subsection name="Description" id="DuplicateMapOrSetKey_Description">
        <div>
          Checks for duplicate key or element arguments in Java factory methods like
          <code>Map.of</code>, <code>Set.of</code>, and <code>Map.ofEntries</code>.
        </div>
      </subsection>

      <subsection name="Examples" id="DuplicateMapOrSetKey_Examples">
        <p id="Example1-config">
          To configure the check:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-xml">
&lt;module name="Checker"&gt;
  &lt;module name="TreeWalker"&gt;
    &lt;module name="DuplicateMapOrSetKey"/&gt;
  &lt;/module&gt;
&lt;/module&gt;
</code></pre></div>
        <p id="Example1-code">
          Example:
        </p>
        <div class="wrapper"><pre class="prettyprint"><code class="language-java">
class Example1 {
  void test() {
    Map&lt;String, Integer&gt; map = Map.of("key1", 1, "key1", 2); // violation 'Duplicate key or element argument identical to the argument at line 4'
    Set&lt;String&gt; set = Set.of("A", "B", "A");                 // violation 'Duplicate key or element argument identical to the argument at line 5'
  }
}
</code></pre></div>
      </subsection>

